<?xml version="1.0" encoding="utf-8"?>
<!--
  Modelled on swipe_setstarred: a state-list keyed on android.R.attr.state_above_anchor, which
  NewsReaderItemTouchHelperCallback.onChildDraw() toggles once the swipe passes the threshold.
  A plain vector here would never light up.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <selector>
            <item android:state_above_anchor="false"><color android:color="@color/swipeBackground" /></item>
            <item android:state_above_anchor="true"><color android:color="@color/aiMoreColor" /></item>
        </selector>
    </item>
    <item
        android:right="5dp"
        android:left="5dp"
        android:drawable="@drawable/ic_thumb_up_white_24"
        android:gravity="center">
    </item>
</layer-list>
